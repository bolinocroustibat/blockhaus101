# App settings
ENVIRONMENT=local
APP_PORT=8000
POSTGRES_PORT=5433

# Django core settings
DEBUG=False
DJANGO_SECRET_KEY="your-secret-key-here"
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database for local app. Port must match POSTGRES_PORT.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/blockhaus101_django"
# Database if the app is run inside a container:
# DATABASE_URL="postgres://postgres:postgres@db:5432/blockhaus101_django"

# Other database for `manage.py sync_remote_db`.
# REMOTE_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/blockhaus101_django"

# Email settings
EMAIL_HOST=your-smtp-host
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# External services
## Image generation: openai or getimg
IMAGE_PROVIDER=getimg

## OpenAI
OPENAI_API_KEY=your-openai-api-key

## GetImgAI
GETIMGAI_API_KEY=your-getimgai-api-key

## Twitter API
TWITTER_CONSUMER_KEY=your-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-twitter-consumer-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

## Sentry
SENTRY_DSN=your-sentry-dsn
